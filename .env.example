# Public configuration only. VITE_ values are included in the browser bundle.
# Postal address for letters, lines separated by "|" (mailbox, branch, city). Empty until the mailbox exists: the page says the address is pending. Never a home address.
VITE_POSTAL_ADDRESS=
# Where the monthly subscription form posts (JSON and plain HTML POST): the Oficina's Formspree form by default. Set it empty to offer the subscription by letter instead of the form.
VITE_FORM_ENDPOINT=https://formspree.io/f/mredjdzd
# Mercado Pago subscription link (the plan Joaquín creates in Mercado Pago). The page shows it after the form; empty: the page says payment is arranged by mail.
VITE_SUBSCRIPTION_URL=
# Replace after purchasing and connecting a domain. Existing production URL:
VITE_PUBLIC_SITE_URL=https://laoficinaexiste.com
