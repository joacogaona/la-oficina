# Public configuration only. VITE_ values are included in the browser bundle.
# Postal address for letters, lines separated by "|" (mailbox, branch, city). Empty until the mailbox exists: the page says the address is pending. Never a home address.
VITE_POSTAL_ADDRESS=
# Replace after purchasing and connecting a domain. Existing production URL:
VITE_PUBLIC_SITE_URL=https://laoficinaexiste.com
